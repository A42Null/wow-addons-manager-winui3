<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="WoW WinUI3 Addons Manager"
      Manufacturer="A42Null"
      Version="$(var.MsiVersion)"
      UpgradeCode="8DCF932F-B15E-408F-A8AD-35AFC67A4E90"
      Scope="perMachine"
      Compressed="yes">
    <SummaryInformation Description="魔兽世界插件管理器 — 浏览/安装/更新魔兽世界插件" />

    <MediaTemplate EmbedCab="yes" />

    <MajorUpgrade DowngradeErrorMessage="已安装更高版本，无法降级安装。" />

    <!-- 与 Advanced Installer (.aip) 保持一致：安装到 Program Files\WoWAddonManager -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="WoWAddonManager" />
    </StandardDirectory>

    <Feature Id="Main" Title="WoWAddonManager" Level="1">
      <ComponentGroupRef Id="AppFiles" />
    </Feature>
  </Package>
</Wix>
