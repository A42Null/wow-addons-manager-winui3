<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="魔兽世界插件管理器 (WoWAddonManager)"
      Manufacturer="A42Null"
      Version="$(var.MsiVersion)"
      UpgradeCode="8F3A2B7C-1D4E-4F6A-9B2C-3E5D6A7B8C9D"
      Scope="perUser"
      Compressed="yes">
    <SummaryInformation Description="魔兽世界插件管理器 — 浏览/安装/更新魔兽世界插件" />

    <MediaTemplate EmbedCab="yes" />

    <MajorUpgrade DowngradeErrorMessage="已安装更高版本，无法降级安装。" />

    <!-- 按用户安装到 %LocalAppData%\WoWAddonManager，无需管理员权限 -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="WoWAddonManager" />
    </StandardDirectory>

    <Feature Id="Main" Title="WoWAddonManager" Level="1">
      <ComponentGroupRef Id="AppFiles" />
    </Feature>
  </Package>
</Wix>
