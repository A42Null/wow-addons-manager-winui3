<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WoWAddonManager.Pages.BrowsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WoWAddonManager.ViewModels">

    <Grid Padding="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="浏览插件" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="搜索并安装魔兽世界插件（客户端版本跟随「设置」中当前选择的版本）"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- 搜索栏 -->
        <Grid Grid.Row="1" Margin="0,12,0,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="SourceCombo" Width="150" SelectedIndex="0"
                      SelectionChanged="OnSourceChanged" />

            <TextBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="输入插件名，如：DBM / WeakAuras"
                     KeyDown="OnSearchBoxKeyDown" />

            <ComboBox x:Name="VersionCombo" Grid.Column="2" Width="170" Visibility="Collapsed"
                      SelectionChanged="OnVersionChanged" />

            <ComboBox x:Name="CategoryCombo" Grid.Column="3" Width="200"
                      DisplayMemberPath="Name" SelectionChanged="OnCategoryChanged" />

            <ComboBox x:Name="SortCombo" Grid.Column="4" Width="130" SelectedIndex="0"
                      SelectionChanged="OnSortChanged">
                <ComboBoxItem Content="最多下载" Tag="6" />
                <ComboBoxItem Content="最热门" Tag="2" />
                <ComboBoxItem Content="最近更新" Tag="3" />
            </ComboBox>

            <Button x:Name="SearchButton" Grid.Column="5" Style="{ThemeResource AccentButtonStyle}"
                    Content="搜索" Click="OnSearchClick" />
        </Grid>

        <InfoBar Grid.Row="1" x:Name="InfoState" IsOpen="False" Margin="0,60,0,0" VerticalAlignment="Top" />

        <!-- 结果列表 -->
        <ListView Grid.Row="2" x:Name="ListResults" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:BrowseRow">
                    <Grid Padding="8,10,8,10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="56" Height="56" CornerRadius="6"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                Visibility="{x:Bind LogoVisibility}">
                            <Image Source="{x:Bind Logo}" Stretch="UniformToFill" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{x:Bind Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock FontSize="12">
                                    <Run Text="版本 " Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><Run Text="{x:Bind VersionText}" FontWeight="SemiBold" />
                                </TextBlock>
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="首发 " /><Run Text="{x:Bind FirstReleasedText}" />
                                </TextBlock>
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="更新 " /><Run Text="{x:Bind UpdatedText}" />
                                </TextBlock>
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="适配 " /><Run Text="{x:Bind GameVersionsText}" />
                                </TextBlock>
                                <TextBlock Text="{x:Bind DownloadText}" FontSize="12" Opacity="0.7" />
                                <TextBlock Text="{x:Bind AuthorText}" FontSize="12" Opacity="0.7" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind Summary}" Opacity="0.8" MaxLines="2"
                                       TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                        </StackPanel>

                        <Button Grid.Column="2" Content="安装" Tag="{x:Bind}" Click="OnInstallClick"
                                VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 分页 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,8,0,0">
            <Button x:Name="PrevPageButton" Content="上一页" Click="OnPrevPageClick" />
            <TextBlock x:Name="PageText" Text="第 1 页" VerticalAlignment="Center" />
            <Button x:Name="NextPageButton" Content="下一页" Click="OnNextPageClick" />
        </StackPanel>

        <!-- 忙碌遮罩 -->
        <Grid Grid.Row="0" Grid.RowSpan="4" x:Name="BusyOverlay" Visibility="Collapsed" Background="#7F000000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <ProgressRing IsActive="True" Width="48" Height="48" />
                <TextBlock x:Name="BusyText" Text="加载中…" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
